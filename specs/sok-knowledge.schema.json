{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/sok-knowledge.schema.json",
  "title": "Structure of Knowledge Core Knowledge Package",
  "description": "Artifact-independent knowledge package centered on field-native elements and canonical typed relations. Public sok-report arrays are compatibility projections from these elements and relation IDs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "elements"],
  "properties": {
    "schema_version": { "const": "sok-knowledge/v1" },
    "field": { "type": "string" },
    "elements": {
      "type": "array",
      "items": { "$ref": "#/$defs/knowledge_element" }
    },
    "relations": {
      "description": "Canonical typed relation graph. Field-element summaries, curriculum prerequisites, and visual edges are projections of these relation IDs.",
      "type": "array",
      "items": { "$ref": "#/$defs/relation" }
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "stable_id": {
      "type": "string",
      "pattern": "^(?!.*--)[a-z][a-z0-9]*-[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
    },
    "localized_text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": { "$ref": "#/$defs/non_empty_string" },
        "locale": { "type": "string" }
      }
    },
    "semantic_role": {
      "type": "string",
      "enum": [
        "core",
        "surrounding",
        "context",
        "concept",
        "method",
        "representation",
        "object",
        "practice",
        "evidence",
        "frontier",
        "other"
      ]
    },
    "knowledge_element": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "element_class", "label", "actual_form"],
      "properties": {
        "id": { "$ref": "#/$defs/stable_id" },
        "element_class": {
          "description": "Open-ended field-native class, not a closed ontology.",
          "$ref": "#/$defs/non_empty_string"
        },
        "label": { "$ref": "#/$defs/localized_text" },
        "actual_form": { "$ref": "#/$defs/localized_text" },
        "semantic_roles": {
          "type": "array",
          "items": { "$ref": "#/$defs/semantic_role" }
        },
        "role_note": { "type": "string" },
        "relation_ids": {
          "description": "Relation IDs that touch this element. Public load-bearing relation prose is derived from these relations.",
          "type": "array",
          "items": { "$ref": "#/$defs/stable_id" }
        },
        "load_bearing_relations": {
          "description": "Legacy compatibility summary retained for v1/v2 reads. New projections derive this text from relation_ids.",
          "type": "string"
        },
        "source_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/stable_id" }
        },
        "confidence": {
          "type": "string",
          "enum": ["high", "medium", "low", "unknown"]
        }
      }
    },
    "relation_kind": {
      "type": "string",
      "enum": [
        "requires_before",
        "introduced_by",
        "revisits",
        "deepens",
        "applies",
        "assessed_by",
        "remediates"
      ]
    },
    "relation_endpoint_type": {
      "type": "string",
      "enum": [
        "field_element",
        "concept",
        "claim",
        "source",
        "curriculum_step",
        "frontier_debate",
        "method",
        "representation"
      ]
    },
    "relation_endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_type", "id"],
      "properties": {
        "entity_type": { "$ref": "#/$defs/relation_endpoint_type" },
        "id": { "$ref": "#/$defs/stable_id" }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "from", "to"],
      "properties": {
        "id": { "$ref": "#/$defs/stable_id" },
        "kind": { "$ref": "#/$defs/relation_kind" },
        "from": { "$ref": "#/$defs/relation_endpoint" },
        "to": { "$ref": "#/$defs/relation_endpoint" },
        "description": { "type": "string" },
        "source_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/stable_id" }
        }
      }
    }
  }
}

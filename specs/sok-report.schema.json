{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/sok-report.schema.json",
  "title": "Structure of Knowledge JSON Report",
  "description": "Public SoK report payload with a metadata envelope plus optional non-public internal context and diagnostics.",
  "type": "object",
  "additionalProperties": false,
  "required": ["metadata", "report"],
  "properties": {
    "metadata": { "$ref": "#/$defs/metadata" },
    "report": { "$ref": "#/$defs/public_report" },
    "internal_context": { "$ref": "#/$defs/internal_context" },
    "diagnostics": { "$ref": "#/$defs/diagnostics" }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "stable_id": {
      "type": "string",
      "pattern": "^(?!.*--)[a-z][a-z0-9]*-[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
    },
    "string_list": {
      "type": "array",
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "generated_at",
        "report_type",
        "temporal_review"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "pattern": "^sok-report/v[0-9]+$"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "report_type": {
          "type": "string",
          "enum": ["scaffold", "human_report"]
        },
        "temporal_review": { "$ref": "#/$defs/temporal_marker" },
        "generator": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": { "$ref": "#/$defs/non_empty_string" },
            "version": { "type": "string" }
          }
        }
      }
    },
    "temporal_marker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["as_of", "temporal_status"],
      "properties": {
        "as_of": {
          "type": "string",
          "format": "date"
        },
        "review_after": {
          "type": "string",
          "format": "date"
        },
        "temporal_status": {
          "type": "string",
          "enum": ["durable", "current", "review_due", "stale", "unknown"]
        },
        "rationale": { "type": "string" }
      }
    },
    "public_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "scope",
        "domain_profile",
        "core_ideas",
        "methods",
        "representations",
        "evidence_standards",
        "sources",
        "claims",
        "relations",
        "curriculum_path",
        "frontier_debates"
      ],
      "properties": {
        "field": { "$ref": "#/$defs/non_empty_string" },
        "scope": { "$ref": "#/$defs/scope" },
        "domain_profile": { "$ref": "#/$defs/domain_profile" },
        "literature_ladder": {
          "type": "array",
          "items": { "$ref": "#/$defs/literature_ladder_row" }
        },
        "core_ideas": {
          "type": "array",
          "items": { "$ref": "#/$defs/knowledge_item" }
        },
        "methods": {
          "type": "array",
          "items": { "$ref": "#/$defs/knowledge_item" }
        },
        "representations": {
          "type": "array",
          "items": { "$ref": "#/$defs/knowledge_item" }
        },
        "evidence_standards": { "$ref": "#/$defs/evidence_standards" },
        "sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/source_record" }
        },
        "claims": {
          "type": "array",
          "items": { "$ref": "#/$defs/claim" }
        },
        "relations": {
          "type": "array",
          "items": { "$ref": "#/$defs/relation" }
        },
        "curriculum_path": {
          "type": "array",
          "items": { "$ref": "#/$defs/curriculum_step" }
        },
        "frontier_debates": {
          "type": "array",
          "items": { "$ref": "#/$defs/frontier_debate_item" }
        },
        "visual_views": {
          "type": "array",
          "items": { "$ref": "#/$defs/visual_view" }
        },
        "structure_waivers": {
          "type": "array",
          "items": { "$ref": "#/$defs/structure_waiver" }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "included", "excluded"],
      "properties": {
        "summary": { "$ref": "#/$defs/non_empty_string" },
        "included": { "$ref": "#/$defs/string_list" },
        "excluded": { "$ref": "#/$defs/string_list" },
        "assumptions": { "$ref": "#/$defs/string_list" },
        "interpretive_notes": { "$ref": "#/$defs/string_list" }
      }
    },
    "domain_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "rationale"],
      "properties": {
        "classification": {
          "type": "string",
          "enum": [
            "well_structured",
            "formal",
            "ill_structured",
            "professional_practice",
            "instrument_bound",
            "infrastructure_bound",
            "emerging",
            "interdisciplinary",
            "mixed"
          ]
        },
        "secondary_characteristics": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "well_structured",
              "formal",
              "ill_structured",
              "professional_practice",
              "instrument_bound",
              "infrastructure_bound",
              "emerging",
              "interdisciplinary",
              "mixed"
            ]
          }
        },
        "rationale": { "$ref": "#/$defs/non_empty_string" },
        "failure_modes": { "$ref": "#/$defs/string_list" }
      }
    },
    "knowledge_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "description"],
      "properties": {
        "id": { "$ref": "#/$defs/stable_id" },
        "label": { "$ref": "#/$defs/non_empty_string" },
        "description": { "$ref": "#/$defs/non_empty_string" },
        "aliases": { "$ref": "#/$defs/string_list" },
        "source_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/stable_id" }
        },
        "temporal": { "$ref": "#/$defs/temporal_marker" }
      }
    },
    "literature_ladder_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "layer",
        "start_here",
        "read_for",
        "do_not_infer",
        "source_ids"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/stable_id" },
        "layer": { "$ref": "#/$defs/non_empty_string" },
        "start_here": { "$ref": "#/$defs/non_empty_string" },
        "read_for": { "$ref": "#/$defs/non_empty_string" },
        "do_not_infer": { "$ref": "#/$defs/non_empty_string" },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/stable_id" }
        },
        "notes": { "type": "string" }
      }
    },
    "evidence_standards": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "claim_policy", "source_role_requirements"],
      "properties": {
        "summary": { "$ref": "#/$defs/non_empty_string" },
        "claim_policy": { "$ref": "#/$defs/non_empty_string" },
        "source_role_requirements": {
          "type": "array",
          "items": { "$ref": "#/$defs/source_role_requirement" }
        }
      }
    },
    "source_role": {
      "type": "string",
      "enum": [
        "orientation",
        "foundation",
        "method",
        "representation",
        "evidence",
        "synthesis",
        "frontier",
        "debate",
        "standard",
        "dataset",
        "infrastructure",
        "critique",
        "curriculum",
        "other"
      ]
    },
    "source_role_requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "requirement", "rationale"],
      "properties": {
        "role": { "$ref": "#/$defs/source_role" },
        "requirement": {
          "type": "string",
          "enum": ["required", "conditional", "waived", "not_applicable"]
        },
        "minimum_sources": {
          "type": "integer",
          "minimum": 0
        },
        "rationale": { "$ref": "#/$defs/non_empty_string" },
        "waiver": { "$ref": "#/$defs/source_role_waiver" }
      }
    },
    "source_role_waiver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rationale", "as_of"],
      "properties": {
        "rationale": { "$ref": "#/$defs/non_empty_string" },
        "as_of": {
          "type": "string",
          "format": "date"
        },
        "review_after": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "source_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "citation",
        "source_type",
        "roles",
        "access",
        "why_it_matters",
        "verification_status"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/stable_id" },
        "citation": { "$ref": "#/$defs/non_empty_string" },
        "title": { "type": "string" },
        "source_type": { "$ref": "#/$defs/non_empty_string" },
        "identifier": { "type": "string" },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "date": { "type": "string" },
        "roles": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/source_role" }
        },
        "access": { "$ref": "#/$defs/source_access_metadata" },
        "why_it_matters": { "$ref": "#/$defs/non_empty_string" },
        "verification_status": { "$ref": "#/$defs/verification_status" },
        "last_reviewed": {
          "type": "string",
          "format": "date"
        },
        "notes": { "type": "string" }
      }
    },
    "source_access_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "route"],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "open_access",
            "free_web",
            "public_domain",
            "official_open",
            "user_provided",
            "library",
            "paid_book",
            "paywalled",
            "subscription",
            "restricted",
            "unknown"
          ]
        },
        "route": { "$ref": "#/$defs/non_empty_string" },
        "budget_estimate": { "type": "string" },
        "license": { "type": "string" },
        "metadata_only": { "type": "boolean" },
        "notes": { "type": "string" }
      }
    },
    "verification_status": {
      "type": "string",
      "enum": ["cataloged", "reviewed", "verified"]
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "statement",
        "claim_type",
        "evidence_requirement",
        "evidence_links",
        "temporal"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/stable_id" },
        "statement": { "$ref": "#/$defs/non_empty_string" },
        "claim_type": {
          "type": "string",
          "enum": [
            "structural",
            "currentness",
            "frontier",
            "debate",
            "curricular",
            "interpretive",
            "methodological"
          ]
        },
        "evidence_requirement": {
          "type": "string",
          "enum": [
            "none",
            "cataloged_source",
            "reviewed_source",
            "verified_source",
            "multiple_reviewed_sources"
          ]
        },
        "evidence_links": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence_link" }
        },
        "confidence": {
          "type": "string",
          "enum": ["high", "medium", "low", "unknown"]
        },
        "temporal": { "$ref": "#/$defs/temporal_marker" },
        "notes": { "type": "string" }
      }
    },
    "evidence_link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "verification_status", "support_kind"],
      "properties": {
        "evidence_id": { "$ref": "#/$defs/stable_id" },
        "source_id": { "$ref": "#/$defs/stable_id" },
        "verification_status": { "$ref": "#/$defs/verification_status" },
        "support_kind": {
          "type": "string",
          "enum": ["supports", "qualifies", "contradicts", "background", "example"]
        },
        "locator": { "type": "string" },
        "support_note": { "type": "string" },
        "reviewed_at": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "from", "to"],
      "properties": {
        "id": { "$ref": "#/$defs/stable_id" },
        "kind": {
          "type": "string",
          "enum": [
            "depends_on",
            "supports",
            "qualifies",
            "contradicts",
            "precedes",
            "introduces",
            "uses_method",
            "represented_by",
            "grounds",
            "motivates",
            "part_of",
            "maps_to"
          ]
        },
        "from": { "$ref": "#/$defs/relation_endpoint" },
        "to": { "$ref": "#/$defs/relation_endpoint" },
        "description": { "type": "string" }
      }
    },
    "relation_endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_type", "id"],
      "properties": {
        "entity_type": {
          "type": "string",
          "enum": [
            "concept",
            "claim",
            "source",
            "curriculum_step",
            "frontier_debate",
            "method",
            "representation"
          ]
        },
        "id": { "$ref": "#/$defs/stable_id" }
      }
    },
    "curriculum_step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sequence",
        "title",
        "learning_goal",
        "practice_artifact",
        "source_ids"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/stable_id" },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "title": { "$ref": "#/$defs/non_empty_string" },
        "learning_goal": { "$ref": "#/$defs/non_empty_string" },
        "prerequisite_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/stable_id" }
        },
        "practice_artifact": { "$ref": "#/$defs/non_empty_string" },
        "progress_criteria": { "$ref": "#/$defs/string_list" },
        "source_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/stable_id" }
        }
      }
    },
    "frontier_debate_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "title", "summary", "why_it_matters", "temporal"],
      "properties": {
        "id": { "$ref": "#/$defs/stable_id" },
        "kind": {
          "type": "string",
          "enum": ["frontier", "debate", "open_problem", "uncertainty"]
        },
        "title": { "$ref": "#/$defs/non_empty_string" },
        "summary": { "$ref": "#/$defs/non_empty_string" },
        "why_it_matters": { "$ref": "#/$defs/non_empty_string" },
        "required_background_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/stable_id" }
        },
        "claim_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/stable_id" }
        },
        "source_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/stable_id" }
        },
        "temporal": { "$ref": "#/$defs/temporal_marker" }
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checks"],
      "properties": {
        "summary": { "type": "string" },
        "checks": {
          "type": "array",
          "items": { "$ref": "#/$defs/diagnostic" }
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "severity", "message"],
      "properties": {
        "check_id": { "$ref": "#/$defs/non_empty_string" },
        "severity": {
          "type": "string",
          "enum": ["info", "warning", "error"]
        },
        "status": {
          "type": "string",
          "enum": ["passed", "failed", "not_applicable"]
        },
        "message": { "$ref": "#/$defs/non_empty_string" },
        "target_path": { "type": "string" },
        "entity_id": { "$ref": "#/$defs/stable_id" }
      }
    },
    "visual_view": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "title", "justification", "nodes", "edges"],
      "properties": {
        "id": { "$ref": "#/$defs/stable_id" },
        "kind": {
          "type": "string",
          "enum": [
            "knowledge_spine",
            "concept_source",
            "dependency_path",
            "frontier_debate",
            "custom"
          ]
        },
        "title": { "$ref": "#/$defs/non_empty_string" },
        "justification": { "$ref": "#/$defs/non_empty_string" },
        "nodes": {
          "type": "array",
          "items": { "$ref": "#/$defs/visual_view_node" }
        },
        "edges": {
          "type": "array",
          "items": { "$ref": "#/$defs/visual_view_edge" }
        }
      }
    },
    "visual_view_node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "entity_type"],
      "properties": {
        "id": { "$ref": "#/$defs/stable_id" },
        "label": { "$ref": "#/$defs/non_empty_string" },
        "entity_type": {
          "type": "string",
          "enum": [
            "concept",
            "claim",
            "source",
            "curriculum_step",
            "frontier_debate",
            "method",
            "representation"
          ]
        },
        "ref_id": { "$ref": "#/$defs/stable_id" },
        "description": { "type": "string" }
      }
    },
    "visual_view_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "kind"],
      "properties": {
        "from": { "$ref": "#/$defs/stable_id" },
        "to": { "$ref": "#/$defs/stable_id" },
        "kind": { "$ref": "#/$defs/non_empty_string" },
        "relation_id": { "$ref": "#/$defs/stable_id" },
        "label": { "type": "string" }
      }
    },
    "structure_waiver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "rationale"],
      "properties": {
        "scope": {
          "type": "string",
          "enum": ["relations", "curriculum_prerequisites", "visual_views"]
        },
        "rationale": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "internal_context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "raw_learner_profile": { "type": "string" },
        "original_goal": { "type": "string" },
        "prompt_derived_assumptions": { "$ref": "#/$defs/string_list" },
        "placeholder_state": {
          "type": "object",
          "additionalProperties": true
        },
        "handoff_notes": { "$ref": "#/$defs/string_list" }
      }
    }
  }
}
